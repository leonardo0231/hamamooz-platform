DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=replace-with-a-unique-random-secret-of-at-least-50-characters
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=api.example.com
DJANGO_CORS_ALLOWED_ORIGINS=https://app.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://app.example.com

POSTGRES_DB=hamamooz
POSTGRES_USER=hamamooz
POSTGRES_PASSWORD=replace-with-a-strong-database-password
DATABASE_URL=postgresql://hamamooz:replace-with-a-strong-database-password@db:5432/hamamooz?sslmode=prefer

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CELERY_TASK_ALWAYS_EAGER=false

USE_S3=true
AWS_ACCESS_KEY_ID=replace-with-a-dedicated-storage-access-key
AWS_SECRET_ACCESS_KEY=replace-with-a-strong-storage-secret-key
AWS_STORAGE_BUCKET_NAME=hamamooz-private
AWS_S3_ENDPOINT_URL=http://minio:9000
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ADDRESSING_STYLE=path
AWS_QUERYSTRING_AUTH=true

JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
LOG_LEVEL=INFO
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000
TRUST_X_FORWARDED_FOR=false

BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_SECONDS=86400
