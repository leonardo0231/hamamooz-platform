DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change-me-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000

POSTGRES_DB=hamamooz
POSTGRES_USER=hamamooz
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://hamamooz:change-me@db:5432/hamamooz

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CELERY_TASK_ALWAYS_EAGER=false

USE_S3=true
AWS_ACCESS_KEY_ID=hamamooz
AWS_SECRET_ACCESS_KEY=change-me-minio
AWS_STORAGE_BUCKET_NAME=hamamooz-private
AWS_S3_ENDPOINT_URL=http://minio:9000
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ADDRESSING_STYLE=path
AWS_QUERYSTRING_AUTH=true

JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
SENTRY_DSN=
LOG_LEVEL=INFO
SECURE_SSL_REDIRECT=false

BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_SECONDS=86400
