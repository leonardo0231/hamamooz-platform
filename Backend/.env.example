DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=local-development-secret-change-before-sharing-000000000000000
JWT_SIGNING_KEY=local-jwt-signing-key-change-before-sharing-000000000000000
DJANGO_DEBUG=true

DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000

POSTGRES_DB=hamamooz
POSTGRES_USER=hamamooz
POSTGRES_PASSWORD=hamamooz

DATABASE_URL=postgresql://hamamooz:hamamooz@postgres:5432/hamamooz

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

USE_S3=true

MINIO_ROOT_USER=hamamooz
MINIO_ROOT_PASSWORD=local-minio-development-password

AWS_ACCESS_KEY_ID=hamamooz
AWS_SECRET_ACCESS_KEY=local-minio-development-password
AWS_STORAGE_BUCKET_NAME=hamamooz-media
AWS_S3_ENDPOINT_URL=http://minio:9000
AWS_S3_REGION_NAME=us-east-1
AWS_S3_USE_SSL=false

SECURE_SSL_REDIRECT=false
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false

LOGIN_FAILURE_LIMIT=5
LOGIN_FAILURE_WINDOW_SECONDS=900

LOG_LEVEL=INFO