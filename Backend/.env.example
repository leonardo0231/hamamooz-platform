DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change-me-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=
DJANGO_CSRF_TRUSTED_ORIGINS=

POSTGRES_DB=hamamooz
POSTGRES_USER=hamamooz
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://hamamooz:change-me@db:5432/hamamooz

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CELERY_TASK_ALWAYS_EAGER=false

ATTENDANCE_MAX_EVIDENCE_SIZE=5242880
ATTENDANCE_ASYNC_NOTIFICATIONS=true
TTENDANCE_AUTO_ALERTS_ENABLED=true
ATTENDANCE_ALERT_HOUR=16
ATTENDANCE_ALERT_MINUTE=0
ATTENDANCE_SMS_BACKEND=hamamooz.apps.attendance.notifications.DisabledSMSBackend

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=noreply@hamamooz.local

USE_S3=true
AWS_ACCESS_KEY_ID=hamamooz
AWS_SECRET_ACCESS_KEY=change-me-minio
AWS_STORAGE_BUCKET_NAME=hamamooz-private
AWS_S3_ENDPOINT_URL=http://minio:9000
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ADDRESSING_STYLE=path
AWS_QUERYSTRING_AUTH=true

JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
SENTRY_DSN=
LOG_LEVEL=INFO
SECURE_SSL_REDIRECT=false
TRUST_X_FORWARDED_FOR=false

BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_SECONDS=86400
