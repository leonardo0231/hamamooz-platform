# Optional local overrides. `docker compose up --build -d` also works without this file.
# Never use these local defaults in production.

DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=replace-with-a-long-random-development-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web,frontend
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

POSTGRES_DB=hamamooz
POSTGRES_USER=hamamooz
POSTGRES_PASSWORD=hamamooz-local-password
# Optional: leave empty to build it from POSTGRES_* inside the container.
DATABASE_URL=

REDIS_URL=redis://redis-cache:6379/0
CELERY_BROKER_URL=redis://redis-broker:6379/0
CELERY_RESULT_BACKEND=redis://redis-broker:6379/1
CELERY_TASK_ALWAYS_EAGER=false
CELERY_WORKER_CONCURRENCY=2
USE_S3=false
READINESS_CHECK_BROKER=false
READINESS_CHECK_STORAGE=true

# Local demo bootstrap. It runs idempotently after migrations.
SEED_DEMO=true
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin123!ChangeMe

VITE_APP_NAME=هم‌آموز
VITE_REQUEST_TIMEOUT_MS=20000
HAMAMOOZ_API_PORT=8000
HAMAMOOZ_FRONTEND_PORT=5173
