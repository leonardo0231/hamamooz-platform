DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=replace-with-a-long-random-development-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173

POSTGRES_DB=hamamooz
POSTGRES_USER=hamamooz
POSTGRES_PASSWORD=replace-with-a-local-database-password
DATABASE_URL=postgresql://hamamooz:replace-with-a-local-database-password@db:5432/hamamooz

REDIS_URL=redis://redis-cache:6379/0
CELERY_BROKER_URL=redis://redis-broker:6379/0
CELERY_RESULT_BACKEND=redis://redis-broker:6379/1
CELERY_TASK_ALWAYS_EAGER=false
USE_S3=false
READINESS_CHECK_BROKER=false
READINESS_CHECK_STORAGE=true

VITE_APP_NAME=HamAmoz
VITE_REQUEST_TIMEOUT_MS=20000
HAMAMOOZ_API_PORT=8000
HAMAMOOZ_FRONTEND_PORT=5173
